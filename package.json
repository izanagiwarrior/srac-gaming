{
  "name": "srac-gaming",
  "version": "3.17.1",
  "private": true,
  "description": "Thirteen multiplayer games: Mahjong, Blackjack, Capsa, Chess, Dam, Domino, Empat Berturut, Ludo, Monopoli, Poker, Reversi, Ular Tangga and UNO",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test:ui": "node --test --test-concurrency=1 tests/*.test.js",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "dev:cloudflare": "wrangler dev --local --ip 127.0.0.1 --port 3024",
    "deploy:cloudflare": "wrangler deploy"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "ws": "8.22.0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "wrangler": "4.152.0",
    "miniflare": "5.20261019.2-beta"
  }
}
